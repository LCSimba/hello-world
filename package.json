    "test:links": "jest tests/links.test.js",
    "test:css": "jest tests/css.test.js",
    "test:offline": "jest tests/html.test.js tests/css.test.js"
  },
  "keywords": ["github-pages", "testing", "accessibility"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.8.3",
    "axe-core": "^4.8.3",
    "html-validate": "^8.9.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "playwright": "^1.40.1",
    "stylelint": "^16.1.0",
    "stylelint-config-standard": "^36.0.0"
  }
