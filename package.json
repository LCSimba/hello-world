{
  "name": "hello-world",
  "version": "1.0.0",
  "description": "GitHub Pages website with comprehensive testing",
  "scripts": {
    "test": "jest --testPathIgnorePatterns=accessibility.test.js --testPathIgnorePatterns=links.test.js",
    "test:all": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:html": "jest tests/html.test.js",
